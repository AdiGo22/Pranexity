datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Contact {
  id            Int      @id @default(autoincrement())
  name          String
  email         String
  phone         String?
  message       String
  preferredTime String?
  createdAt     DateTime @default(now())
}
